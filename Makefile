## Executable ##
SHELL		:=C:/Windows/System32/cmd.exe
## The devkitPro make is an MSYS program (MAKE_HOST x86_64-pc-msys). MSYS rewrites a lone "/c" argument into the
## path "C:/" before it starts cmd.exe, so cmd.exe gets no /c switch and runs nothing. "//c" reaches cmd.exe as "/c".
## A native Windows make passes "/c" unchanged.
ifneq ($(findstring msys,$(MAKE_HOST))$(findstring cygwin,$(MAKE_HOST)),)
.SHELLFLAGS	:=//c
else
.SHELLFLAGS	:=/c
endif
PATH		:=C:\Framework\sdk\psx\PSY-Q_4_0\PSYQ;C:\devkitPro\msys2\usr\bin;$(PATH)
CC		=perl tools\ccps.pl
LINK		=PSYLINK
CPE		=tools\cpe2exe.exe

## Commandline ##
CCOPT		=-c
## tools\ccps.pl compiles with the PSY-Q 4.0 compiler (COMPILER\CC1PSX.EXE, GNU C 2.7.2.SN32.3.7): -O2 -G 16 -mgpopt -membedded-data -Wall -comments-c++ (see its header for why)
OVLOPT		=-Wa,s
OVL_G0_FLAGS	=-O2 -G 0 -membedded-data -Wall -comments-c++
## /n raises PSYLINK 2.52's module limit: the link takes about 190 objects plus the library modules it pulls in
LINKOPT		=/c /m /n 1024 /l C:/Framework/sdk/psx/PSY-Q_4_0/PSX/LIB

## Project ##
all: build
build:
