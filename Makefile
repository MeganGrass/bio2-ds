## Executable ##
CC		=perl tools\\ccps.pl
LINK		=PSYLINK
CPE		=perl tools\\cpe2exe.pl

## Commandline ##
CCOPT		=-c
## toolsps.pl compiles with -O2 -G 1000000 -mgpopt -ansi -Wall -comments-c++ -nostdlib (see its header for why)
OVLOPT		=-Wa,s
LINKOPT		=/c /l "C:/Framework/sdk/psx/LIB"

## Project ##
all: build
