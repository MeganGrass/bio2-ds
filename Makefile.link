	org	0x80010000
	regs	pc=__SN_ENTRY_POINT
; Linked with PSYLINK 2.52, the PSY-Q 4.0 linker (the Makefile puts PSY-Q_4_0\PSYQ first on PATH).
; PSYLINK gives every symbol its group's object address (obj), and 2.52 gives a group without obj() the
; object address 0. So the text group names obj(0x80010000), the address the org above already gives;
; .sbss and .bss sit in the text group, so their object addresses follow .data with no address written
; here; and every org() group repeats its address in obj(). Each overlay group names its own obj().

text	group	obj(0x80010000)
	section .rdata,text
	section .text,text
	section .ctors,text
	section .dtors,text
	section .data,text
	section .sdata,text
	section .sbss,text
	section .bss,text

	include	"OBJ\PSX\BUILD\SLD.OBJ"
	include	"OBJ\PSX\BUILD\CD.OBJ"
	include	"OBJ\PSX\BUILD\DOOR.OBJ"
